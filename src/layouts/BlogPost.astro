---
import '../styles/global.css';
import { withBase } from '../lib/urls.js';
import type { CollectionEntry } from 'astro:content';
import ViewToggle from '../components/ui/ViewToggle.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, date, tags, description, readingTime } = post.data;
const formattedDate = new Date(date).toISOString().split('T')[0];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link rel="alternate" type="application/rss+xml" title="Wintermute RSS" href={withBase('rss.xml')} />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Wintermute</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=JetBrains+Mono:wght@500&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <nav id="nav">
    <a href={withBase()} class="nav-logo">Wintermute</a>
    <ul class="nav-links">
      <li><a href={withBase('#posts')}>Posts</a></li>
      <li><a href={withBase('#personas')}>Personas</a></li>
    </ul>
  </nav>

  <main id="main-content">
  <article>
    <div class="prose-container">
      <header class="post-header">
        <p class="section-label">// {formattedDate}</p>
        <h1>{title}</h1>
        <div class="post-meta-bar">
          {readingTime && <span>{readingTime}</span>}
          <div class="card-tags">
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </div>
      </header>

      <div class="prose">
        {post.data.readingViews && <ViewToggle />}
        <slot />
      </div>

      <div class="system-disclaimer">
        <span class="disclaimer-label">⚠️ SYSTEM NOTICE</span>
        <p>This synthesis was generated by the Wintermute AI Think Tank. Persona voices are simulated, not statements by the people who inspired them. External figures, quotations, dates, and technical claims have not been independently verified; historical articles retain their original context. Verify critical claims against primary sources.</p>
      </div>

      <a href={withBase()} class="back-link">← Home</a>
      <a href={withBase('archive/')} class="back-link" style="margin-left: 24px;">← Archive</a>
    </div>
  </article>
  </main>

  <footer>
    <p class="footer-copy">Wintermute &copy; 2026 — Synthesized Intelligence</p>
  </footer>

  <script>
    const nav = document.getElementById('nav');
    window.addEventListener('scroll', () => {
      nav?.classList.toggle('scrolled', window.scrollY > 40);
    });
  </script>

</body>
</html>

<style>
  .system-disclaimer {
    margin-top: 64px;
    padding: 24px;
    background-color: rgba(0, 255, 157, 0.03);
    border: 1px solid rgba(0, 255, 157, 0.15);
    border-radius: var(--r-sm);
    font-family: var(--font-mono);
  }
  .disclaimer-label {
    display: block;
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--signal);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .system-disclaimer p {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .prose-container {
    max-width: 720px;
    margin: 0 auto;
    padding: 160px 24px 96px;
  }
</style>
