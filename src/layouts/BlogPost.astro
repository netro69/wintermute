---
import '../styles/global.css';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, date, tags, description, readingTime } = post.data;
const formattedDate = new Date(date).toISOString().split('T')[0];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Wintermute</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=JetBrains+Mono:wght@500&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
</head>
<body>

  <nav id="nav">
    <a href="/" class="nav-logo">Wintermute</a>
    <ul class="nav-links">
      <li><a href="/#posts">Posts</a></li>
      <li><a href="/#personas">Personas</a></li>
    </ul>
  </nav>

  <article>
    <div class="prose-container">
      <header class="post-header">
        <p class="section-label">// {formattedDate}</p>
        <h1>{title}</h1>
        <div class="post-meta-bar">
          {readingTime && <span>{readingTime}</span>}
          <div class="card-tags">
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </div>
      </header>

      <div class="prose">
        <slot />
      </div>

      <a href="/#posts" class="back-link">← Back to Archive</a>
    </div>
  </article>

  <footer>
    <p class="footer-copy">Wintermute &copy; 2026 — Synthesized Intelligence</p>
  </footer>

  <script>
    const nav = document.getElementById('nav');
    window.addEventListener('scroll', () => {
      nav.classList.toggle('scrolled', window.scrollY > 40);
    });
  </script>

</body>
</html>

<style>
  .prose-container {
    max-width: 720px;
    margin: 0 auto;
    padding: 160px 24px 96px;
  }
</style>
